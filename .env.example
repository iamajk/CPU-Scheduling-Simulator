# ══════════════════════════════════════════════
#   CPU Scheduling Simulator — Environment Variables
#   Copy this file to .env and fill in your values
# ══════════════════════════════════════════════

# Server
PORT=5000
NODE_ENV=development

# MongoDB — replace with your connection string
MONGO_URI=mongodb://localhost:27017/cpuscheduler

# JWT Secret — use a long random string in production
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Client URL (for CORS). In production set this to your deployed frontend origin,
# e.g. https://cpu-scheduling-simulator.netlify.app
CLIENT_URL=http://localhost:5000
